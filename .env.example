# Seconds to wait for each platform API before reporting a timeout
REQUEST_TIMEOUT=10

# Telegram: token from @BotFather, and the public channel username the bot is an admin of
TELEGRAM_BOT_TOKEN=123456789:replace-with-bot-token
TELEGRAM_CHANNEL=your_public_channel

# Mastodon: access token with the write:statuses scope
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=replace-with-access-token

# Bluesky: account handle and an app password (not the account password)
BLUESKY_HANDLE=yourname.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# GitHub: fine-grained personal access token with "Gists: Read and write"
GITHUB_TOKEN=github_pat_replace-with-token

# WordPress.com: site address and an OAuth2 access token (see README for how to generate it)
WORDPRESS_SITE=yoursite.wordpress.com
WORDPRESS_ACCESS_TOKEN=replace-with-access-token
